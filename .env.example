# Empty Firebase values enable the public demo only.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Production accounts require an absolute path on a durable local volume.
COLLABSPHERE_DB_PATH=data/collabsphere.sqlite
PORT=3000

# Local Auth Emulator only: use the demo-collabsphere Firebase project.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Production: use Application Default Credentials with Firebase Auth read access.
# Set GOOGLE_APPLICATION_CREDENTIALS only in the server runtime if needed.
